# ══════════════════════════════════════════════════════════════════
#  NEXUS CLI — nexus.glenhalton.com
#  Apache/LiteSpeed .htaccess — conservative shared-hosting build.
#  Every module-dependent block is guarded; no Options overrides that
#  some cPanel configs reject; no DOCUMENT_ROOT assumptions.
# ══════════════════════════════════════════════════════════════════

AddDefaultCharset UTF-8
DirectoryIndex index.html

# ── Hardening ───────────────────────────────────────────────────────
# Block dotfiles/dirs (.git, .nexus, .htaccess itself, editor configs)
<IfModule mod_alias.c>
  RedirectMatch 404 (^|/)\.(?!well-known)
</IfModule>

# Deploy artifacts, backups, agent/config files — never serve
<FilesMatch "(?i)\.(sh|zip|tar|gz|bak|old|log|sql|ini|lock|yml|yaml|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)-legacy\.html$">
  Require all denied
</FilesMatch>

# ── Rewrites ────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (preserve the original Host so local or alternate hosts are not forced to the
  # canonical production host). This uses the request Host header instead of a hard-coded
  # domain. If you *do* want to force a single canonical host in production, change the
  # target to https://nexus.glenhalton.com%{REQUEST_URI} (but keep it guarded behind an env
  # or deploy-time replace to avoid breaking local/testing).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Strip www (preserve Host). This removes a leading www. while keeping the current Host
  # value (so www.example.com -> https://example.com). Note: some setups prefer a single
  # canonical host — change if needed.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Pretty routes → page files (internal, no redirect)
  RewriteRule ^docs/?$ docs.html [L]
  RewriteRule ^mcp/?$ mcp.html [L]
  RewriteRule ^agents/?$ agents.html [L]

  # Extensionless pages: /<page> → <page>.html when it exists.
  # REQUEST_FILENAME resolves correctly per-directory on cPanel
  # (DOCUMENT_ROOT does not, on many subdomain setups).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── MIME ────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .css .js .svg .txt .xml .json
</IfModule>

# ── Compression ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/plain             "access plus 1 day"
  ExpiresByType application/xml        "access plus 1 day"
  ExpiresByType text/xml               "access plus 1 day"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 30 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ── Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header always unset X-Powered-By
</IfModule>

# ── Errors ──────────────────────────────────────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
