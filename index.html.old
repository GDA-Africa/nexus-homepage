            <div class="t-body" style="font-size:10.5px"><div style="color:var(--cb);font-weight:700;margin-bottom:6px;font-family:'Orbitron',sans-serif;font-size:9.5px">AI LAYER</div><div><span class="t-ok">✓</span> 8 structured docs</div><div><span class="t-ok">✓</span> Project Brain</div><div><span class="t-ok">✓</span> Knowledge Base</div><div><span class="t-ok">✓</span> 190 tests passing</div></div>
