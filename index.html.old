<script>
/* ─── PARTICLES ─── */
(function(){
  const cv=document.getElementById('stars'),cx=cv.getContext('2d');
  function resize(){cv.width=innerWidth;cv.height=innerHeight}
  resize();addEventListener('resize',resize);
  const cols=['rgba(255,255,255,.7)','rgba(167,139,250,.55)','rgba(6,182,212,.45)','rgba(255,255,255,.35)'];
  const pts=Array.from({length:130},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.2,vy:(Math.random()-.5)*.2,r:Math.random()*1.6+.3,op:Math.random()*.4+.06,col:cols[Math.random()*cols.length|0],ph:Math.random()*Math.PI*2,sp:Math.random()*.012+.004}));
  let fr=0;
  (function draw(){cx.clearRect(0,0,cv.width,cv.height);fr++;pts.forEach(p=>{p.x=(p.x+p.vx+cv.width)%cv.width;p.y=(p.y+p.vy+cv.height)%cv.height;cx.globalAlpha=p.op*(.35+(Math.sin(fr*p.sp+p.ph)+1)*.325);cx.fillStyle=p.col;cx.beginPath();cx.arc(p.x,p.y,p.r,0,Math.PI*2);cx.fill()});cx.globalAlpha=1;requestAnimationFrame(draw)})();
})();

/* ─── HELPERS ─── */
const $=id=>document.getElementById(id);
function vis(id,d=0){setTimeout(()=>{const e=$(id);if(e)e.style.opacity='1'},d)}
function hide(id){const e=$(id);if(e)e.style.opacity='0'}
function typeIn(el,text,spd=44,cb){if(!el)return;el.textContent='';let i=0;const t=setInterval(()=>{el.textContent+=text[i++];if(i>=text.length){clearInterval(t);if(cb)cb()}},spd)}
function countUp(id,target,ms=1400){const el=$(id);if(!el)return;const s=performance.now();(function u(now){const p=Math.min((now-s)/ms,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(e*target);if(p<1)requestAnimationFrame(u)})(s)}
function setScene(n){document.querySelectorAll('.scene').forEach(s=>s.classList.remove('active'));const s=$('s'+n);if(s)s.classList.add('active');$('scene-indicator').textContent='0'+n+' / 06'}
function doWipe(cb){const w=$('wipe');w.classList.remove('go');void w.offsetWidth;w.classList.add('go');setTimeout(cb,320);setTimeout(()=>w.classList.remove('go'),680)}

/* ─── NEXUS TREE DATA ─── */
const nxTree=[
  {t:'my-app/',c:'cd',cm:''},{t:'  src/',c:'cp',cm:''},
  {t:'  .nexus/',c:'cn',cm:''},{t:'    docs/',c:'cn',cm:''},
  {t:'    ├─ 01_vision.md',c:'ca',cm:'← What are we building?'},
  {t:'    ├─ 02_architecture.md',c:'ca',cm:'← System design'},
  {t:'    └─ ...08_deployment.md',c:'ca',cm:'← 8 AI-readable docs'},
  {t:'    ai/instructions.md',c:'cc',cm:'← The AI brain'},
  {t:'    index.md',c:'cn',cm:'← Project brain'},
  {t:'    knowledge.md',c:'cm',cm:'← Memory layer'},
  {t:'  .cursorrules',c:'ct',cm:'← Cursor'},{t:'  AGENTS.md',c:'ct',cm:'← Claude Code'},
  {t:'  .windsurfrules',c:'ct',cm:'← Windsurf'},
];

/* ─── ANIMATION TIMELINE ─── */
let TOs=[],progStart=null,progRaf=null;
const TOTAL=92000;
function T(ms,fn){TOs.push(setTimeout(fn,ms))}
function clearTOs(){TOs.forEach(clearTimeout);TOs=[]}

function scene1(){
  setScene(1);
  T(400,()=>$('cw1').style.opacity='1');T(900,()=>typeIn($('q1'),"What's the project architecture?",38));T(2600,()=>$('a1').style.opacity='1');
  T(1600,()=>$('cw2').style.opacity='1');T(2100,()=>typeIn($('q2'),"How should I name this component?",38));T(3800,()=>$('a2').style.opacity='1');
  T(3100,()=>$('cw3').style.opacity='1');T(3600,()=>typeIn($('q3'),"What did we decide about routing?",38));T(5200,()=>$('a3').style.opacity='1');
  T(5900,()=>{[$('cw1'),$('cw2'),$('cw3')].forEach(w=>{if(w){w.style.opacity='.18';w.style.filter='grayscale(1)';w.style.transition='all .6s'}});[$('x1'),$('x2'),$('x3')].forEach(x=>{if(x)x.style.opacity='1'})});
  T(7000,()=>$('s1c').style.opacity='1');T(7300,()=>$('h1a').style.opacity='1');T(8100,()=>$('h1b').style.opacity='1');T(9000,()=>$('h1s').style.opacity='1');
}
function scene2(){
  setScene(2);
  T(300,()=>{const g=$('g2');g.style.opacity='1';g.style.transform='scale(1)';g.style.transition='opacity .6s ease,transform .9s cubic-bezier(.34,1.56,.64,1)'});
  T(1100,()=>vis('s2t'));T(2400,()=>vis('s2b'));T(3700,()=>vis('s2m'));
}
function scene3(){
  setScene(3);
  const c=$('nxl');c.innerHTML='';
  nxTree.forEach(item=>{const d=document.createElement('div');d.className='tl '+item.c;d.innerHTML='<span>'+item.t+'</span>'+(item.cm?'<span class="tc">'+item.cm+'</span>':'');c.appendChild(d)});
  T(300,()=>vis('s3h'));T(700,()=>{vis('s3b');document.querySelectorAll('#s3b .tl').forEach((l,i)=>T(i*80,()=>l.classList.add('on')))});
  T(1400,()=>vis('s3a'));c.querySelectorAll('.tl').forEach((l,i)=>T(1700+i*140,()=>l.classList.add('on')));
  T(1700+nxTree.length*140+300,()=>vis('s3ct'));T(3400,()=>{vis('s3to');document.querySelectorAll('#s3to .badge').forEach((b,i)=>{b.style.opacity='0';T(i*180,()=>{b.style.opacity='1';b.style.animation='badgePop .4s ease both'})})});
}
function scene4(){
  setScene(4);
  T(300,()=>vis('s4h'));T(900,()=>{$('n1').classList.add('on');T(200,()=>$('f1').style.width='100%')});T(1200,()=>vis('cv1'));
  T(2600,()=>{$('n2').classList.add('on');T(200,()=>$('f2').style.width='100%')});T(2900,()=>vis('cv2'));
  T(4300,()=>$('n3').classList.add('now'));T(4700,()=>vis('cv3'));
  T(6000,()=>{vis('s4st');countUp('st1',190,1600);T(300,()=>countUp('st2',6,900));T(600,()=>countUp('st3',4,700));T(900,()=>countUp('st4',5,800))});
}
function scene5(){
  setScene(5);
  T(400,()=>vis('s5q'));T(1900,()=>vis('s5a'));T(2600,()=>vis('s5sk'));T(3900,()=>vis('s5e'));
  T(5400,()=>{vis('s5tr');T(600,()=>typeIn($('s5cmd'),'nexus skill new auth-flow',55,()=>{$('s5cur').style.display='none';T(300,()=>$('s5out').style.display='block')}))});
}
function scene6(){
  setScene(6);
  T(300,()=>vis('s6ow'));T(1400,()=>vis('s6t'));T(2700,()=>vis('s6l'));T(4000,()=>vis('s6q'));
  T(6000,()=>vis('s6enter'));
}
function resetAnim(){
  clearTOs();if(progRaf)cancelAnimationFrame(progRaf);
  document.querySelectorAll('.scene').forEach(s=>s.classList.remove('active'));
  $('intro-progress').style.width='0%';
  [$('cw1'),$('cw2'),$('cw3')].forEach(w=>{if(!w)return;w.style.opacity='0';w.style.filter='';});
  [$('x1'),$('x2'),$('x3')].forEach(x=>{if(x)x.style.opacity='0'});
  ['q1','q2','q3'].forEach(id=>{const e=$(id);if(e)e.textContent=''});
  ['a1','a2','a3'].forEach(id=>hide(id));
  ['s1c','h1a','h1b','h1s','s2t','s2b','s2m','s3h','s3b','s3a','s3ct','s3to','s4h','cv1','cv2','cv3','s4st','s5q','s5a','s5sk','s5e','s5tr','s6ow','s6t','s6l','s6q','s6enter'].forEach(id=>hide(id));
  const g=$('g2');if(g){g.style.opacity='0';g.style.transform='scale(.4)';g.style.transition=''}
  ['n1','n2','n3'].forEach(id=>{const e=$(id);if(e){e.classList.remove('on','now')}});
  ['f1','f2'].forEach(id=>{const e=$(id);if(e)e.style.width='0%'});
  ['st1','st2','st3','st4'].forEach(id=>{const e=$(id);if(e)e.textContent='0'});
  const sc=$('s5cmd');if(sc)sc.textContent='';const scur=$('s5cur');if(scur)scur.style.display='inline-block';const so=$('s5out');if(so)so.style.display='none';
  document.querySelectorAll('.tl').forEach(l=>l.classList.remove('on'));
}
function startAnim(){
  resetAnim();
  progStart=performance.now();
  (function tick(){const e=Math.min((performance.now()-progStart)/TOTAL*100,100);$('intro-progress').style.width=e+'%';if(e<100)progRaf=requestAnimationFrame(tick)})(performance.now());
  T(80,scene1);
  T(14000,()=>doWipe(scene2));
  T(30000,()=>doWipe(scene3));
  T(50000,()=>doWipe(scene4));
  T(63000,()=>doWipe(scene5));
  T(82000,()=>doWipe(scene6));
}
function enterSite(){
  clearTOs();if(progRaf)cancelAnimationFrame(progRaf);
  const overlay=$('intro-overlay');
  overlay.classList.add('fading');
  const site=$('main-site');site.style.opacity='1';
  const nav=$('nav');setTimeout(()=>nav.classList.add('visible'),600);
  setTimeout(()=>{overlay.style.display='none';document.body.style.overflowY='auto'},950);
  $('skip-btn').style.display='none';
  $('intro-progress').style.display='none';
  $('scene-indicator').style.display='none';
}
function skipToEnd(){doWipe(()=>{scene6();T(3000,enterSite)})}
function scrollToTop(){window.scrollTo({top:0,behavior:'smooth'})}

/* ─── SCROLL ANIMATIONS ─── */
const observer=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('up')})},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal,.reveal-l,.reveal-r,.reveal-s').forEach(el=>observer.observe(el));

/* ─── NAV ON SCROLL ─── */
let siteVisible=false;
window.addEventListener('scroll',()=>{if(!siteVisible)return;const nav=$('nav');if(window.scrollY>50)nav.classList.add('visible');else nav.classList.remove('visible')});

/* ─── QUICK START TERMINAL ANIMATION ─── */
const qsLines=['ql1','ql2','ql3','ql4','ql5','ql6','ql7','ql8','ql9','qla','qlb','qlc','qld','qle','qlf','qlg','qlh','qli'];
let qsPlayed=false;
const qsObserver=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting&&!qsPlayed){qsPlayed=true;qsLines.forEach((id,i)=>setTimeout(()=>{const l=$(id);if(l)l.classList.add('on')},i*110))}})},{threshold:.3});
const qt=$('qs-terminal');if(qt)qsObserver.observe(qt);

/* ─── INIT ─── */
document.body.style.overflowY='hidden';
addEventListener('load',()=>{
  siteVisible=false;
  setTimeout(()=>{startAnim()},400);
  // Pre-reveal hero elements for after animation
  document.querySelectorAll('#hero .reveal').forEach(el=>{
    setTimeout(()=>el.classList.add('up'),200);
  });
});
</script>
</body>
</html>
