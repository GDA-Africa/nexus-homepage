      <div id="s6enter" style="opacity:0;transition:opacity .6s;margin-top:6px">
        <button onclick="enterSite()" style="padding:12px 28px;background:linear-gradient(135deg,var(--violet),var(--v2));border:none;color:white;font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;border-radius:6px;cursor:pointer;box-shadow:0 0 28px rgba(124,58,237,.45);transition:all .25s" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 0 44px rgba(124,58,237,.65)'" onmouseout="this.style.transform='';this.style.boxShadow='0 0 28px rgba(124,58,237,.45)'">ENTER SITE →</button>
