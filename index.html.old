        <div style="text-align:center"><div style="font-family:'Orbitron',sans-serif;font-size:clamp(20px,3vw,38px);font-weight:900;color:var(--cb)" id="st2">0</div><div class="mono" style="font-size:8.5px;color:var(--tm);letter-spacing:2.5px;margin-top:3px">FRAMEWORKS</div></div>
        <div style="text-align:center"><div style="font-family:'Orbitron',sans-serif;font-size:clamp(20px,3vw,38px);font-weight:900;color:var(--green)" id="st3">0</div><div class="mono" style="font-size:8.5px;color:var(--tm);letter-spacing:2.5px;margin-top:3px">COMMANDS</div></div>
        <div style="text-align:center"><div style="font-family:'Orbitron',sans-serif;font-size:clamp(20px,3vw,38px);font-weight:900;color:var(--amber)" id="st4">0</div><div class="mono" style="font-size:8.5px;color:var(--tm);letter-spacing:2.5px;margin-top:3px">AI TOOLS</div></div>
