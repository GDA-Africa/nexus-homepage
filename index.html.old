        <div style="position:absolute;top:50%;left:50%;margin:-17px 0 0 -17px;width:34px;height:34px;border-radius:7px;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:13px;animation:orbitSpin 9s linear infinite;animation-delay:-1.8s">🧠</div>
        <div style="position:absolute;top:50%;left:50%;margin:-17px 0 0 -17px;width:34px;height:34px;border-radius:7px;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:13px;animation:orbitSpin 9s linear infinite;animation-delay:-3.6s">⚡</div>
        <div style="position:absolute;top:50%;left:50%;margin:-17px 0 0 -17px;width:34px;height:34px;border-radius:7px;background:var(--card);border:1px solid rgba(167,139,250,.4);display:flex;align-items:center;justify-content:center;font-size:13px;animation:orbitSpin 9s linear infinite;animation-delay:-5.4s;color:var(--vb)">◆</div>
        <div style="position:absolute;top:50%;left:50%;margin:-17px 0 0 -17px;width:34px;height:34px;border-radius:7px;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:13px;animation:orbitSpin 9s linear infinite;animation-delay:-7.2s">🔧</div>
        <div class="gem-wrap" style="width:90px;height:90px;animation:gemFloat 4s ease-in-out infinite">
